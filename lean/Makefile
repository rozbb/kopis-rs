# Kopis verification convenience targets.
#
# Run from this directory (kopis-rs/lean).  These wrap the `lake` invocations
# for the Kopis KEM correspondence proofs and the spec test-vector runner.
# Extraction (Rust -> Lean) lives in `../extract_rust_to_lean.sh`, which
# regenerates `ExtractedRustSerial.lean`, `ExtractedRustAvx2.lean` and
# `ExtractedRustNeon.lean`; this file only builds/checks what is already
# extracted, plus the files it generates itself (see "Generated audit files"
# below).

LAKE ?= lake

# Cap the number of parallel Lean workers.  Each Lean+Mathlib worker resident set
# is ~1.75 GB; `lake` defaults its build parallelism to the core count (nproc).  On
# a memory-constrained host (e.g. 4 cores / 4 GB RAM) that over-subscribes RAM and
# the build swap-thrashes — a clean build takes ~15-20 min instead of ~4 min.
# Set this to 2 to keep peak memory ~3.5 GB and avoid the thrash.
#LEAN_NUM_THREADS ?= 8
#export LEAN_NUM_THREADS

.DEFAULT_GOAL := help

# ---------------------------------------------------------------------------
# Generated audit files
# ---------------------------------------------------------------------------
#
# `TopLevelTheoremsSerial.lean` is the audit surface: the top-level statements a
# human reviewer reads.  Those statements are the same for every backend — only
# the names differ — so the per-backend copies are generated from it by swapping
# the backend-bearing identifiers, and an auditor reads one file rather than one
# per backend.  There are two copies, AVX2 and NEON, and both are in the build
# graph.  `TrustBase.lean` holds the part that genuinely *does* differ per
# backend (the assumptions), and is hand-written.
#
# The copies are checked in, so `lake build`, CI and the editor all work without
# make in the loop, and so a reviewer sees them at the commit they review.  Make
# keeps them current: the rule below regenerates when the source is newer, and
# fails if that changed anything, because a checked-in generated file that every
# build silently repairs is a file nobody ever verifies.  That failure is the
# whole point of the `cmp`.
#
# (An earlier version of this comment claimed the `cmp` was also load-bearing for
# build times — that rewriting the copy unconditionally would bump its mtime and
# force lake to re-elaborate it and everything downstream.  That is not true of
# this lake: a bumped mtime on an unchanged file costs a *rehash*, and the stored
# trace then matches, so the module is replayed rather than re-elaborated.
# Measured 2026-08-03: `touch`ing all 60 twin modules plus this file and
# rebuilding takes 1.5 s.  Keep the `cmp` for the failure; do not re-add the
# performance claim.)

GENERATED_AUDIT := TopLevelTheoremsAvx2.lean TopLevelTheoremsNeon.lean

# The recipe is shared rather than copied per backend: every backend-bearing identifier is
# derived from $(1), the backend's camel-case name, so a third copy of these six `sed` rules
# would be a third place for them to drift.  See the two notes below the `.PHONY: generated`
# target for what the last two rules are doing.
define audit_copy
	@printf '%s\n' '-- AUTOGENERATED from TopLevelTheoremsSerial.lean by `make generated`.  Do not edit.' > $@.tmp
	@sed -e 's/ExtractedRustSerial/ExtractedRust$(1)/g' \
	     -e 's/RustKopisSerial/RustKopis$(1)/g' \
	     -e 's/TopLevelSerial/TopLevel$(1)/g' \
	     -e 's/^import Kopis$$/import Kopis.$(1).Properties/' \
	     -e 's/Kopis\.Properties/Kopis.$(1).Properties/g' \
	     -e 's/^namespace Kopis\.TopLevel$(1)$$/open Kopis.$(1)\nnamespace Kopis.TopLevel$(1)/' $< >> $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else \
	  mv $@.tmp $@; \
	  echo "*** $@ was out of date and has been regenerated from $<."; \
	  echo "*** Review the diff and commit it, then re-run."; \
	  exit 1; \
	fi
endef

TopLevelTheoremsAvx2.lean: TopLevelTheoremsSerial.lean Makefile
	$(call audit_copy,Avx2)

TopLevelTheoremsNeon.lean: TopLevelTheoremsSerial.lean Makefile
	$(call audit_copy,Neon)

.PHONY: generated
generated: $(GENERATED_AUDIT) twins

# ---------------------------------------------------------------------------
# The generated twin proof stack
# ---------------------------------------------------------------------------
#
# `Kopis/Avx2/Properties/*.lean` is `Kopis/Properties/*.lean` with the extracted
# constants and the stack's own namespace renamed, plus the anchored patches for
# the runtime-dispatch points (scripts/gen_avx2_twins.py, and
# scripts/gen_avx2_bridge.py for the four `cpu::available` sites in the NTT).
# Derived in full from the serial stack.
#
# Unlike the audit copy above it is **not** checked in, and so the rule is
# different in two ways.  It regenerates silently instead of failing, because
# there is no committed copy for a reviewer to have reviewed — the thing under
# review is the serial proof and the patch list, both of which are.  And it is
# `.PHONY` rather than file-tracked: the twins depend on every serial module,
# both generator scripts and the patch anchors inside them, so any dependency
# list would be a second source of truth that could drift.  Running it always is
# correct by construction, and costs ~50 ms.
#
# The generator writes a file only when its content changes (`write_if_changed`).
# That is *not* needed to keep the build fast — see the note on the audit-copy
# rule above; lake replays an unchanged module whatever its mtime says.  It is
# there so that the generator's own output ("3 written, 57 unchanged") reports
# what a serial edit actually propagated to, which is the first thing you want to
# know when a patch anchor moves.
#
# The serial and AVX2 proof targets both depend on this, not just the AVX2 one:
# `TrustBase.lean` carries a row per backend, so it imports both of the audit
# surfaces that compile.  `prove-kopis-neon` does not — there is no NEON twin
# stack yet.
.PHONY: twins
twins:
	@python3 scripts/gen_avx2_twins.py
	@python3 scripts/gen_neon_twins.py

# ---------------------------------------------------------------------------
# Proofs
# ---------------------------------------------------------------------------

# Everything: every backend, with the generated audit files brought up to date
# first.  This is the target to run before committing.
.PHONY: prove-kopis
prove-kopis: prove-kopis-serial prove-kopis-avx2 prove-kopis-neon

# The portable backend: the extracted ExtractedRustSerial.lean plus every
# Kopis/Properties/*.lean, then
# TopLevelTheoremsSerial.lean, which restates the top-level results, and
# TrustBase.lean, which re-checks their axiom footprint against the audited list.
# A green build IS the machine-checked proof.  Note that TrustBase now holds both
# backends' rows, so this target builds the AVX2 stack too — hence the generated
# prerequisites; for the serial proofs alone, run
# `lake build Kopis TopLevelTheoremsSerial`.
.PHONY: prove-kopis-serial
prove-kopis-serial: $(GENERATED_AUDIT) twins
	$(LAKE) build Kopis TopLevelTheoremsSerial TrustBase

# The AVX2 backend.  This builds the second extraction (ExtractedRustAvx2.lean,
# from an `--cfg kopis_backend="avx2"` build), Kopis/Avx2/Intrinsics.lean — which
# *assumes* the semantics of the opaque SIMD wrappers — and the AVX2 proofs
# themselves.  See ../lean/AVX2_VERIFICATION_PLAN.md.
#
# The generated twin proof stack is brought up to date by the `twins` prerequisite
# above; `TopLevelTheoremsAvx2` then pulls it into the build.  Note that this means
# a bare `lake build` does *not* work from a fresh clone — the twins are not checked
# in, so go through `make`.  The generator's patches are anchored on exact serial
# text and fail loudly when a serial proof moves under them.
#
# Two notes on the generated audit copy.  It inherits `import Kopis`, the *serial*
# aggregator, which no backend-name substitution reaches, and it refers to this
# stack's own namespace as `Properties.…`; the two sed rules above rewrite those
# specially.  `TrustBase.lean` now carries a second `backends` row for
# RustKopisAvx2, so the AVX2 audit list is enforced, not merely documented.
.PHONY: prove-kopis-avx2
prove-kopis-avx2: $(GENERATED_AUDIT) twins
	$(LAKE) build KopisAvx2 TopLevelTheoremsAvx2 TrustBase

# The NEON backend.  This builds the third extraction (ExtractedRustNeon.lean, from an
# `--cfg kopis_backend="neon" -C target-feature=+sha3` build cross-compiled for
# aarch64-unknown-linux-gnu) and Kopis/Neon/Intrinsics.lean, which *assumes* the semantics of the
# opaque SIMD wrappers.  See ../lean/NEON_VERIFICATION_PLAN.md.
#
# **It proves nothing yet** — the target name is aspirational, exactly as
# `prove-kopis-avx2` was at commit c5b9ad1.  What a green build here means is that the extraction
# typechecks and the 46 intrinsic axioms are well-formed against it; the correspondence proofs are
# phases C onward in the plan.
#
# Note what is *not* a prerequisite.  There is no `twins` yet (no Kopis/Neon/Properties), and
# TrustBase is not built, because it would have nothing to check: `TopLevelTheoremsNeon.lean` is
# generated by `make generated` and is deliberately **not** in the build graph — like its AVX2
# counterpart before phase E, it cannot compile until the twin proof stack exists.  When it does,
# add `TopLevelTheoremsNeon` and `TrustBase` here and a third row to `backends` in TrustBase.lean.
.PHONY: prove-kopis-neon
prove-kopis-neon: $(GENERATED_AUDIT) twins
	$(LAKE) build KopisNeon TopLevelTheoremsNeon TrustBase

# ---------------------------------------------------------------------------
# Spec tests
# ---------------------------------------------------------------------------

# Run the audited Lean spec against the standard Kopis test vectors + KAT, and the TurboSHAKE
# spec against ../tests/turboshake_vectors.jsonl (SpecTests/Kopis/Run.lean).  The TurboSHAKE
# leg matters because the serial backend *assumes* the `turboshake` crate implements that spec,
# so a typo in it would be absorbed into the assumption rather than caught by a proof.
# `lake exe` builds the executable first.
# Must be run from this directory: the runner reads ../tests/ref_test_vectors-*.jsonl and
# ../tests/turboshake_vectors.jsonl relative to the current directory.
.PHONY: test-kopis-spec
test-kopis-spec:
	$(LAKE) exe kopisTests

# Check the assumed AVX2 intrinsic semantics against real silicon.
#
# `Kopis/Avx2/Intrinsics.lean` is 42 axioms about what Intel instructions do; nothing in the
# proof checks them, and a wrong one makes every AVX2 theorem worthless without any error.
# `Kopis/Avx2/Model.lean` gives each a computable model and *proves* the axiom pins the result
# down to exactly that model, so testing the model tests the axiom.  This target replays
# ../tests/intrinsics_vectors.jsonl — recorded by executing the real instructions, see
# ../src/backend/avx2/intrinsics_vectors.rs — through the models.
#
# Regenerate the vectors on an AVX2 host with
#   KOPIS_REGEN_VECTORS=1 cargo test --lib intrinsics_vectors
# and note that a plain `cargo test` there re-checks the committed file against that CPU.
.PHONY: test-avx2-model
test-avx2-model:
	$(LAKE) exe avx2Tests

# The same for NEON, against `Kopis/Neon/Model.lean` and the 46 axioms of
# `Kopis/Neon/Intrinsics.lean`.  ../tests/neon_intrinsics_vectors.jsonl is committed — 50 176
# vectors recorded on an Apple M1 — so this replays anywhere.  To re-record it, on Apple silicon
# (or another FEAT_SHA3 AArch64 machine):
#
#   RUSTFLAGS='-C target-feature=+sha3' KOPIS_REGEN_VECTORS=1 \
#     cargo test --lib neon::intrinsics_vectors     # writes the vectors
#   make test-neon-model                            # replays them through the models
#
# A plain `cargo test` on that host re-checks the committed file against that CPU.
.PHONY: test-neon-model
test-neon-model:
	$(LAKE) exe neonTests

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

.PHONY: help
help:
	@echo "Kopis targets (run from kopis-rs/lean):"
	@echo "  make prove-kopis         every backend, regenerating what is generated first"
	@echo "  make prove-kopis-serial  the portable backend: the proofs and their trust base"
	@echo "  make prove-kopis-avx2    the AVX2 backend: proofs, intrinsic axioms, trust base"
	@echo "  make prove-kopis-neon    the NEON backend: extraction and intrinsic axioms (no proofs yet)"
	@echo "  make generated           bring every generated file up to date"
	@echo "  make twins               regenerate the AVX2 twin proof stack only"
	@echo "  make test-kopis-spec     run the Lean spec test vectors + KAT + TurboSHAKE (lake exe kopisTests)"
	@echo "  make test-avx2-model     check the assumed AVX2 intrinsic semantics against silicon"
	@echo "  make test-neon-model     the same for NEON (needs vectors recorded on AArch64)"
	@echo ""
	@echo "  Parallelism is capped at LEAN_NUM_THREADS=$(LEAN_NUM_THREADS) to fit RAM on small hosts."
	@echo "  On a machine with more memory, raise it: make prove-kopis LEAN_NUM_THREADS=8"
