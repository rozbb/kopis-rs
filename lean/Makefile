# Kopis verification convenience targets.
#
# Run from this directory (kopis-rs/lean).  These wrap the `lake` invocations
# for the Kopis KEM correspondence proofs and the spec test-vector runner.
# Extraction (Rust -> Lean) lives in `../extract_rust_to_lean.sh`, which
# regenerates `ExtractedRustSerial.lean` and `ExtractedRustAvx2.lean`; this file
# only builds/checks what is already extracted, plus the one Lean file it
# generates itself (see "Generated audit files" below).

LAKE ?= lake

# Cap the number of parallel Lean workers.  Each Lean+Mathlib worker resident set
# is ~1.75 GB; `lake` defaults its build parallelism to the core count (nproc).  On
# a memory-constrained host (e.g. 4 cores / 4 GB RAM) that over-subscribes RAM and
# the build swap-thrashes — a clean build takes ~15-20 min instead of ~4 min.
# Set this to 2 to keep peak memory ~3.5 GB and avoid the thrash.
LEAN_NUM_THREADS ?= 8
export LEAN_NUM_THREADS

.DEFAULT_GOAL := help

# ---------------------------------------------------------------------------
# Generated audit files
# ---------------------------------------------------------------------------
#
# `TopLevelTheoremsSerial.lean` is the audit surface: the top-level statements a
# human reviewer reads.  Those statements are the same for every backend — only
# the names differ — so the per-backend copies are generated from it by swapping
# the three backend-bearing identifiers, and an auditor reads one file rather
# than one per backend.  `TrustBase.lean` holds the part that genuinely *does*
# differ per backend (the assumptions), and is hand-written.
#
# The copies are checked in, so `lake build`, CI and the editor all work without
# make in the loop, and so a reviewer sees them at the commit they review.  Make
# keeps them current: the rule below regenerates when the source is newer, and
# fails if that changed anything, because a checked-in generated file that every
# build silently repairs is a file nobody ever verifies.  The `cmp` matters for
# more than the message — rewriting the copy unconditionally would touch its
# mtime and force lake to re-elaborate it and everything downstream on every
# single build.

GENERATED_AUDIT := TopLevelTheoremsAvx2.lean

TopLevelTheoremsAvx2.lean: TopLevelTheoremsSerial.lean Makefile
	@printf '%s\n' '-- AUTOGENERATED from TopLevelTheoremsSerial.lean by `make generated`.  Do not edit.' > $@.tmp
	@sed -e 's/ExtractedRustSerial/ExtractedRustAvx2/g' \
	     -e 's/RustKopisSerial/RustKopisAvx2/g' \
	     -e 's/TopLevelSerial/TopLevelAvx2/g' \
	     -e 's/^import Kopis$$/import Kopis.Avx2.Properties/' \
	     -e 's/Kopis\.Properties/Kopis.Avx2.Properties/g' $< >> $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else \
	  mv $@.tmp $@; \
	  echo "*** $@ was out of date and has been regenerated from $<."; \
	  echo "*** Review the diff and commit it, then re-run."; \
	  exit 1; \
	fi

.PHONY: generated
generated: $(GENERATED_AUDIT)

# ---------------------------------------------------------------------------
# Proofs
# ---------------------------------------------------------------------------

# Everything: every backend, with the generated audit files brought up to date
# first.  This is the target to run before committing.
.PHONY: prove-kopis
prove-kopis: prove-kopis-serial prove-kopis-avx2

# The portable backend, and the only one anything is currently *proved* about:
# the extracted ExtractedRustSerial.lean plus every Kopis/Properties/*.lean, then
# TopLevelTheoremsSerial.lean, which restates the top-level results, and
# TrustBase.lean, which re-checks their axiom footprint against the audited list.
# A green build IS the machine-checked proof.
.PHONY: prove-kopis-serial
prove-kopis-serial:
	$(LAKE) build Kopis TopLevelTheoremsSerial TrustBase

# The AVX2 backend.  This builds the second extraction (ExtractedRustAvx2.lean,
# from an `--cfg kopis_backend="avx2"` build), Kopis/Avx2/Intrinsics.lean — which
# *assumes* the semantics of the opaque SIMD wrappers — and the AVX2 proofs
# themselves.  See ../lean/AVX2_VERIFICATION_PLAN.md.
#
# This target does not pass yet, and that is deliberate.  46 of the 59 twins in
# `TopLevelTheoremsAvx2.lean` are proved; the remaining 13 are downstream of two
# dispatch points in Kopis/Avx2/Properties/NttMul.lean that cannot be discharged by
# the serial lemmas.  Those lemmas are stated over the integer value of an `i32`
# lane, which on the serial backend is one residue mod 50330113 and on AVX2 is two
# 16-bit residues (mod 7681 and 10753) packed together — so they are false here,
# not merely unproved.  The replacement routes through Kopis/Avx2/NttWalk.lean; the
# plan document lists what is left, in dependency order.
#
# Two consequences worth knowing about.  `TrustBase.lean` still has only the serial
# row in `backends`, so the AVX2 audit list is not enforced yet.  And the generated
# copy inherits `import Kopis`, the *serial* aggregator, which no backend-name
# substitution reaches; the sed rule below rewrites that line specially.
.PHONY: prove-kopis-avx2
prove-kopis-avx2: $(GENERATED_AUDIT)
	$(LAKE) build KopisAvx2 TopLevelTheoremsAvx2 TrustBase

# ---------------------------------------------------------------------------
# Spec tests
# ---------------------------------------------------------------------------

# Run the audited Lean spec against the standard Kopis test vectors + KAT
# (SpecTests/Kopis/Run.lean).  `lake exe` builds the executable first.
# Must be run from this directory: the runner reads ../tests/ref_test_vectors-*.jsonl
# relative to the current directory.
.PHONY: test-kopis-spec
test-kopis-spec:
	$(LAKE) exe kopisTests

# Check the assumed AVX2 intrinsic semantics against real silicon.
#
# `Kopis/Avx2/Intrinsics.lean` is 45 axioms about what Intel instructions do; nothing in the
# proof checks them, and a wrong one makes every AVX2 theorem worthless without any error.
# `Kopis/Avx2/Model.lean` gives each a computable model and *proves* the axiom pins the result
# down to exactly that model, so testing the model tests the axiom.  This target replays
# ../tests/intrinsics_vectors.jsonl — recorded by executing the real instructions, see
# ../src/backend/avx2/intrinsics_vectors.rs — through the models.
#
# Regenerate the vectors on an AVX2 host with
#   KOPIS_REGEN_VECTORS=1 cargo test --lib intrinsics_vectors
# and note that a plain `cargo test` there re-checks the committed file against that CPU.
.PHONY: test-avx2-model
test-avx2-model:
	$(LAKE) exe avx2Tests

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

.PHONY: help
help:
	@echo "Kopis targets (run from kopis-rs/lean):"
	@echo "  make prove-kopis         every backend, regenerating the audit copies first"
	@echo "  make prove-kopis-serial  the portable backend: the proofs and their trust base"
	@echo "  make prove-kopis-avx2    the AVX2 backend: proofs, intrinsic axioms, trust base"
	@echo "                           (does not pass yet — see AVX2_VERIFICATION_PLAN.md)"
	@echo "  make generated           bring the generated audit copies up to date"
	@echo "  make test-kopis-spec     run the Lean spec test vectors + KAT (lake exe kopisTests)"
	@echo "  make test-avx2-model     check the assumed AVX2 intrinsic semantics against silicon"
	@echo ""
	@echo "  Parallelism is capped at LEAN_NUM_THREADS=$(LEAN_NUM_THREADS) to fit RAM on small hosts."
	@echo "  On a machine with more memory, raise it: make prove-kopis LEAN_NUM_THREADS=8"
