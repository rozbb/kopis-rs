  obtain ⟨h1, h2, h3, h4⟩ := hok
  refine ⟨h1, h2, ?_, ?_⟩
  · intro n hn r' hr'
    rw [h3 n hn r' hr']
    exact congrArg _ (Finset.sum_congr rfl fun i hi => by
      show ((g (i * 1 + r') : ℤ) : ZMod 7681) * _ = _
      rw [h (i * 1 + r') (by have := Finset.mem_range.mp hi; omega)])
  · intro n hn r' hr'
    rw [h4 n hn r' hr']
    exact congrArg _ (Finset.sum_congr rfl fun i hi => by
      show ((g (i * 1 + r') : ℤ) : ZMod 10753) * _ = _
      rw [h (i * 1 + r') (by have := Finset.mem_range.mp hi; omega)])

