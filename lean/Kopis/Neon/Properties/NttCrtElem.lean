  (∀ c, c < 256 → |eZ ne c| ≤ 3840) ∧
  (∀ c, c < 256 → |eZ ne (256 + c)| ≤ 5376) ∧
  State zeta1 256 1 1 (fun c => ((g c : ℤ) : ZMod 7681))
    (fun c => ((eZ ne c : ℤ) : ZMod 7681)) ∧
  State zeta2 256 1 1 (fun c => ((g c : ℤ) : ZMod 10753))
    (fun c => ((eZ ne (256 + c) : ℤ) : ZMod 10753))

